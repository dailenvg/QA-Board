{
  "name": "@pinpoint/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pdfjs-assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "node scripts/copy-pdfjs-assets.mjs && next dev",
    "build": "node scripts/copy-pdfjs-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed:accounts": "tsx --import ./scripts/register-sql.mjs scripts/seed-accounts.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@pinpoint/server": "workspace:*",
    "@pinpoint/widget": "workspace:*",
    "@sparticuz/chromium-min": "153.0.0",
    "@vercel/blob": "^2.8.2",
    "fflate": "^0.8.3",
    "motion": "^14.6.0",
    "next": "15.5.28",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
