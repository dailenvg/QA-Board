# pinpoint demo: copy to .env.local for local development.

# Required. Shared secret reviewers append as ?review=<token>. Server-only.
PINPOINT_REVIEW_TOKEN=change-me

# NOT needed: NEXT_PUBLIC_PINPOINT_REVIEW_TOKEN. The token arrives in the
# review link and is never baked into the client bundle.

# GitHub storage, used when both are set. Fine-grained token with
# contents:write, issues:write, pull_requests:read, metadata:read on GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# Required to sign in to Squint. Accounts, sessions and share links live here (migrated on
# first use). Also pinpoint's Postgres storage, used when the GitHub vars are not set.
# Without it nobody can sign in, and shares live in the server's memory: one copy per
# instance, lost on restart (local use only).
# Local example: postgres://squint:squint@127.0.0.1:54329/squint_dev
DATABASE_URL=

# Optional. The canonical app URL that password reset links point at, e.g.
# https://www.squintreview.com (production only). Unset: NEXT_PUBLIC_SITE_URL, else the
# deployment's own URL on Vercel, else http://localhost:3000. Never the request's Host.
AUTH_URL=

# Optional. Password reset emails go through Resend when both are set, e.g.
# EMAIL_FROM="Squint <hello@squintreview.com>". Unset: no email is sent and the server
# logs "reset email skipped" (never the address or link).
RESEND_API_KEY=
EMAIL_FROM=

# Required to keep a workspace project's review link: its token and owner key are encrypted
# at rest (AES-256-GCM, key derived with HKDF). Password-protected links' guest passes are
# signed with a key derived from it too. Sessions don't use it (they're random tokens checked
# against Postgres). Changing it makes existing links' secrets unreadable and ends every pass.
AUTH_SECRET=
# Not read yet. Reserved by the Phase 1 setup (Milestone 5, encrypting per-project proxy
# credentials).
PROJECT_AUTH_KEY=

# Seed script only (pnpm --filter @pinpoint/demo seed:accounts); never read by the app.
# Creates the admin, the company workspace and its owner in DATABASE_URL. Idempotent: it
# never overwrites an existing password. Passwords need 12 to 256 characters. The script
# reads the process environment only, not this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
COMPANY_SLUG=
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PASSWORD=

# Optional, unit tests only (pnpm test). A throwaway Postgres on 127.0.0.1 or localhost where
# lib/auth/login-concurrency.test.ts proves the login limits under real parallel requests
# (PGlite runs one transaction at a time). Unset: that test is skipped.
# TEST_DATABASE_URL=postgres://squint:squint@127.0.0.1:54329/squint_unit
TEST_DATABASE_URL=

# Playwright only (pnpm test:e2e). A throwaway Postgres on 127.0.0.1 or localhost: the e2e
# setup empties it, then seeds test accounts. The suite refuses to start without it.
# E2E_DATABASE_URL=postgres://squint:squint@127.0.0.1:54329/squint_e2e
E2E_DATABASE_URL=

# Optional. POSTs per minute per IP (default 10).
PINPOINT_RATE_LIMIT=

# Optional. Show /review-link outside Vercel previews (local dev, e2e). Never set in production.
PINPOINT_ENABLE_REVIEW_LINK=

# Optional. Force the widget on outside Vercel previews (local dev).
NEXT_PUBLIC_PINPOINT_ENABLED=

# Optional. Squint stores shared images in Vercel Blob (private) when set; otherwise
# in the share store (DATABASE_URL's Postgres, or memory). Workspace files upload straight
# to Vercel Blob when set; otherwise they're kept in Postgres, which only works off Vercel
# (local dev, e2e): a Vercel deployment without it refuses workspace file requests.
# Blob URLs are never sent to browsers.
BLOB_READ_WRITE_TOKEN=

# Optional. Sends Squint's snapshot captures to an external service with the same
# contract as POST /api/capture. Squint still checks the top-level address; the
# service must refuse private addresses for redirects and subresources itself.
# Unset: captures run here in headless Chromium.
SQUINT_CAPTURE_URL=

# Optional, Vercel only. The https URL serverless Chromium's pack tar is downloaded
# from on first use, e.g. a mirror near the functions. Must be https.
# Unset: the matching Sparticuz/chromium GitHub release.
SQUINT_CHROMIUM_PACK_URL=

# Required for the daily cleanup (/api/cron/expire, scheduled in vercel.json). Vercel Cron
# sends it as a bearer token. Unset: the route refuses every call and nothing expires.
CRON_SECRET=

# Tests only (the e2e suite's stub, e2e/clickup-stub.mjs). Stands in for ClickUp's API, which
# workspace owners connect to with their own personal API token (nothing to set up for that).
# Only plain http on 127.0.0.1 or localhost is taken, and never on production; any other value
# turns the integration off, so a stray one can never send a token elsewhere.
CLICKUP_API_URL=

# Set by Vercel automatically; listed here for reference:
# VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV        "preview" enables the widget and /review-link
# VERCEL_GIT_COMMIT_REF, NEXT_PUBLIC_VERCEL_GIT_COMMIT_REF   branch pins are keyed by
# VERCEL_URL, VERCEL_BRANCH_URL             deployment and deep-link origins
