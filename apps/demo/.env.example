# pinpoint demo: copy to .env.local for local development.

# Required. Shared secret reviewers append as ?review=<token>. Server-only.
PINPOINT_REVIEW_TOKEN=change-me

# NOT needed: NEXT_PUBLIC_PINPOINT_REVIEW_TOKEN. The token arrives in the
# review link and is never baked into the client bundle.

# GitHub storage, used when both are set. Fine-grained token with
# contents:write, issues:write, pull_requests:read, metadata:read on GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# Optional. Postgres storage, used when the GitHub vars are not set.
# Migrations run automatically on first request.
# Squint's shared review links use it too (tables squint_*). Without it, shares live
# in the server's memory: one copy per instance, lost on restart. Local use only;
# production sharing needs DATABASE_URL.
DATABASE_URL=

# Optional. POSTs per minute per IP (default 10).
PINPOINT_RATE_LIMIT=

# Optional. Show /review-link outside Vercel previews (local dev, e2e). Never set in production.
PINPOINT_ENABLE_REVIEW_LINK=

# Optional. Force the widget on outside Vercel previews (local dev).
NEXT_PUBLIC_PINPOINT_ENABLED=

# Optional. Squint stores shared images in Vercel Blob (private) when set; otherwise
# in DATABASE_URL's Postgres (or memory). Image URLs are never sent to browsers.
BLOB_READ_WRITE_TOKEN=

# Optional. Squint snapshot capture through an external service that speaks the
# /api/capture contract. Unset: captures run here in headless Chromium.
SQUINT_CAPTURE_URL=

# Set by Vercel automatically; listed here for reference:
# VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV        "preview" enables the widget and /review-link
# VERCEL_GIT_COMMIT_REF, NEXT_PUBLIC_VERCEL_GIT_COMMIT_REF   branch pins are keyed by
# VERCEL_URL, VERCEL_BRANCH_URL             deployment and deep-link origins
