{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "NEXT_DIST_DIR"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/pdfjs/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "E2E_DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_*",
        "PINPOINT_*",
        "VERCEL_*",
        "GITHUB_TOKEN",
        "GITHUB_REPO",
        "DATABASE_URL",
        "SQUINT_CAPTURE_URL",
        "BLOB_READ_WRITE_TOKEN",
        "AUTH_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM"
      ]
    }
  }
}
