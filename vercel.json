{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "demo": {
      "root": "apps/demo",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm --filter \"@pinpoint/demo^...\" run build && pnpm run build"
    },
    "squint-mascot": {
      "root": "squint-mascot",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/mascot", "destination": { "service": "squint-mascot" } },
    { "source": "/mascot/(.*)", "destination": { "service": "squint-mascot" } },
    { "source": "/(.*)", "destination": { "service": "demo" } }
  ]
}
