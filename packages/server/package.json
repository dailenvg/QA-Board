{
  "name": "@pinpoint/server",
  "version": "0.0.0",
  "description": "Route handlers and storage adapters for pinpoint visual feedback.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pinpoint/widget": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
